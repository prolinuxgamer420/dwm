#!/bin/sh

# ─────────────────────────────────────────────
# dwm status
# ─────────────────────────────────────────────

while true; do

  # ─────────────────────────────────────────
  # RAM
  # ─────────────────────────────────────────

  ram=$(awk '
        /MemTotal:/     { total = $2 }
        /MemAvailable:/ { available = $2 }
        END {
            printf "%.1fG", (total - available) / 1024 / 1024
        }
    ' /proc/meminfo)

  # ─────────────────────────────────────────
  # CPU
  # ─────────────────────────────────────────

  read idle total <<EOF
$(awk '/^cpu / {
    total = 0
    for (i = 2; i <= NF; i++)
        total += $i
    print $5, total
}' /proc/stat)
EOF

  if [ -n "$prev_total" ] && [ "$total" -gt "$prev_total" ]; then
    cpu=$(awk \
      -v idle="$idle" \
      -v total="$total" \
      -v prev_idle="$prev_idle" \
      -v prev_total="$prev_total" \
      'BEGIN {
                printf "%.0f", (1 - (idle - prev_idle) / (total - prev_total)) * 100
            }')
  else
    cpu="0"
  fi

  prev_idle=$idle
  prev_total=$total

  # ─────────────────────────────────────────
  # CPU TEMPERATURE
  # ─────────────────────────────────────────

  temp="N/A"

  for zone in /sys/class/thermal/thermal_zone*/temp; do
    [ -r "$zone" ] || continue

    value=$(cat "$zone" 2>/dev/null)

    if [ "$value" -gt 0 ] 2>/dev/null; then
      temp=$(awk -v t="$value" 'BEGIN {
                printf "%.0f°C", t / 1000
            }')
      break
    fi
  done

  # ─────────────────────────────────────────
  # BATTERY
  # ─────────────────────────────────────────

  # Battery
  battery="BAT N/A"

  for bat_path in /sys/class/power_supply/BAT*; do
    [ -d "$bat_path" ] || continue

    capacity=$(cat "$bat_path/capacity" 2>/dev/null)
    status=$(cat "$bat_path/status" 2>/dev/null)

    if [ -n "$capacity" ] && [ "$capacity" -ge 0 ]; then
      case "$status" in
      Charging)
        battery="BAT ${capacity}% ⚡"
        break
        ;;
      Full)
        battery="BAT ${capacity}% ✓"
        break
        ;;
      Discharging)
        battery="BAT ${capacity}%"
        break
        ;;
      esac
    fi
  done

  # ─────────────────────────────────────────
  # VOLUME
  # ─────────────────────────────────────────

  volume_data=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)

  if echo "$volume_data" | grep -q MUTED; then
    volume="MUTE"
  else
    volume=$(echo "$volume_data" | awk '{
            printf "VOL %.0f%%", $2 * 100
        }')
  fi

  [ -n "$volume" ] || volume="VOL N/A"

  # ─────────────────────────────────────────
  # WI-FI
  # ─────────────────────────────────────────

  wifi_device=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null |
    awk -F: '$2 == "wifi" {print $1; exit}')

  if [ -n "$wifi_device" ]; then

    wifi_state=$(nmcli -t -f GENERAL.STATE \
      device show "$wifi_device" 2>/dev/null |
      cut -d: -f2)

    wifi_name=$(nmcli -t -f GENERAL.CONNECTION \
      device show "$wifi_device" 2>/dev/null |
      cut -d: -f2-)

    if echo "$wifi_state" | grep -q '^100'; then
      wifi="WiFi ${wifi_name:-CONNECTED}"
    else
      wifi="WiFi OFF"
    fi

  else
    wifi="WiFi OFF"
  fi

  # ─────────────────────────────────────────
  # CLOCK
  # ─────────────────────────────────────────

  clock=$(date '+%I:%M %p')

  # ─────────────────────────────────────────
  # STATUS BAR
  # ─────────────────────────────────────────

  # The || exit 0 will instantly stop the script when the X display closes
  xsetroot -name \
    "RAM ${ram} | CPU ${cpu}% | TEMP ${temp} | ${battery} | ${volume} | ${wifi} | ${clock}" 2>/dev/null || exit 0

  sleep 1
done
